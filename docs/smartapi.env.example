# Copy the relevant lines into your untracked project-root .env.
# Never commit real credentials or session tokens.
DATA_MODE=smartapi
SMARTAPI_API_KEY=
SMARTAPI_JWT_TOKEN=
SMARTAPI_CLIENT_CODE=
SMARTAPI_LOCAL_IP=
SMARTAPI_PUBLIC_IP=
SMARTAPI_MAC_ADDRESS=
SMARTAPI_LICENSE_CONFIRMED=false
SMARTAPI_TIMEOUT_SECONDS=5
SMARTAPI_MAX_AGE_SECONDS=90
SMARTAPI_POLL_INTERVAL_SECONDS=5

# JSON array. Replace examples with current official MCX instrument-master tokens,
# exact AURORA contract symbols that exist in contracts table, and ISO expiry dates.
# Keep under 50 mappings. Example structure only; tokens below are NOT real.
SMARTAPI_MCX_TOKEN_MAP=[{"token":"REPLACE_WITH_CURRENT_TOKEN","symbol":"GOLDM","expiry_date":"YYYY-MM-DD"}]
