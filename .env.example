# ==============================================================================
# AURORA Platform — Environment Configuration
# ==============================================================================

# Server Configuration
AURORA_HOST=127.0.0.1
AURORA_PORT=8000
AURORA_ENV=development
DEBUG=True

# Database Configuration (SQLite default for local dev, PostgreSQL ready)
# Local SQLite: sqlite:///./aurora.db
# PostgreSQL example: postgresql://user:password@localhost:5432/aurora_db
DATABASE_URL=sqlite:///./aurora.db

# CORS Configuration (Comma-separated list of allowed origins)
# For local frontend testing across file://, localhost:3000, localhost:5500, localhost:8080
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000,http://127.0.0.1:8000

# Market Data Ingestion Mode
# Options: "demo_synthetic", "staged_csv", "live_feed_authorized"
DATA_MODE=demo_synthetic

# Authorized MCX data provider bridge (server-side only). MCX does not publish a
# generic REST protocol; use a distributor-provided bridge matching README.md.
# Get an agreement that permits AURORA's intended processing and storage.
# Set MCX_FEED_LICENSE_CONFIRMED=true only after the agreement is in force.
MCX_FEED_API_KEY=
MCX_FEED_API_SECRET=
MCX_FEED_BASE_URL=
MCX_FEED_PROVIDER_NAME=Authorized MCX Data Distributor
MCX_FEED_QUOTES_PATH=/quotes
MCX_FEED_TIMEOUT_SECONDS=5
MCX_FEED_LIVE_MAX_AGE_SECONDS=90
MCX_FEED_DELAYED_MAX_AGE_SECONDS=1800
MCX_FEED_POLL_INTERVAL_SECONDS=5
MCX_FEED_LICENSE_CONFIRMED=false

# Angel One SmartAPI (REST FULL-quote polling; not WebSocket streaming).
# Copy to your local untracked .env and fill locally. NEVER commit real values.
# Confirm the broker's terms allow your intended storage/display before setting license confirmation.
# Options now include: "demo_synthetic", "staged_csv", "live_feed_authorized", "smartapi"
SMARTAPI_API_KEY=
SMARTAPI_JWT_TOKEN=
SMARTAPI_CLIENT_CODE=
SMARTAPI_LOCAL_IP=
SMARTAPI_PUBLIC_IP=
SMARTAPI_MAC_ADDRESS=
SMARTAPI_LICENSE_CONFIRMED=false
SMARTAPI_TIMEOUT_SECONDS=5
SMARTAPI_MAX_AGE_SECONDS=90
SMARTAPI_POLL_INTERVAL_SECONDS=5
# Use CURRENT tokens from the official instrument master; map only exact existing AURORA symbols.
# Example structure only. Replace token/symbol/expiry with verified current values.
SMARTAPI_MCX_TOKEN_MAP=[{"token":"REPLACE_WITH_CURRENT_TOKEN","symbol":"GOLDM","expiry_date":"YYYY-MM-DD"}]
