# ==============================================================================
# AURORA Platform — Environment Configuration
# ==============================================================================

# Server Configuration
AURORA_HOST=127.0.0.1
AURORA_PORT=8000
AURORA_ENV=development
DEBUG=True

# Database Configuration (SQLite default for local dev, PostgreSQL ready)
# Local SQLite: sqlite:///./aurora.db
# PostgreSQL example: postgresql://user:password@localhost:5432/aurora_db
DATABASE_URL=sqlite:///./aurora.db

# CORS Configuration (Comma-separated list of allowed origins)
# For local frontend testing across file://, localhost:3000, localhost:5500, localhost:8080
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000,http://127.0.0.1:8000

# Market Data Ingestion Mode
# Options: "demo_synthetic", "staged_csv", "live_feed_authorized"
DATA_MODE=demo_synthetic

# Future Live Provider Integration (Placeholder only — Leave blank in demo mode)
# Demo mode operates strictly without requiring any API keys or scraping.
MCX_FEED_API_KEY=
MCX_FEED_API_SECRET=
MCX_FEED_BASE_URL=https://api.mcxindia.com/v1
